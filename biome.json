{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@chyzwar/biome-config/react"],
  "files": {
    "includes": ["**", "!**/icons/*.svg"]
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": ["**/style.json", "**/style-original.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
